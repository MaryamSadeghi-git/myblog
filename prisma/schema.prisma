generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
}
model Like {
  id        String   @id @default(cuid())
  postSlug  String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postSlug, visitorId])
}
model Comment {
  id        Int      @id @default(autoincrement())
  postSlug  String
  author    String
  content   String   @db.Text
  createdAt DateTime @default(now())
}
